RewriteEngine On

# Los artefactos internos no forman parte de la superficie pública.
RewriteRule ^(?:docs|sql|tests|tmp)(?:/|$) - [F,L,NC]

# URL pública del panel global. El parámetro r queda interno al MVC.
RewriteRule ^superadmin/?$ index.php?r=superadmin [QSA,L]

<FilesMatch "(?i)(^\.|^(?:config(?:\.local)?\.php|README(?:\.md)?|ROADMAP\.md|TO DO\.txt)$|\.(?:sql|log|ini|env|bak|dist|md)$)">
  Require all denied
</FilesMatch>
